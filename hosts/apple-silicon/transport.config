# Transport requirements for source 6f63677751854d57bcfac172314957bc2197c05f.
# Resolve together with the host and GPU configuration, not as a full config.
CONFIG_ARM64_16K_PAGES=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_PCIEAER=y
CONFIG_PCIE_APPLE=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_TUNABLE=y
CONFIG_RESET_APPLE_CIO=y
CONFIG_OF_DYNAMIC=y
CONFIG_TYPEC=y
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
CONFIG_USB4_NET=m
CONFIG_DEBUG_FS=y
# CONFIG_USB4_DEBUGFS_WRITE is not set
# CONFIG_USB4_DMA_TEST is not set
# CONFIG_PCI_REALLOC_ENABLE_AUTO is not set
