What this patch changes: the migration engine masks addresses and advances its
cursor in GPU-page units instead of host-page units, and the page-table backing
check accepts host-page-rounded backing while the hardware table size stays
4 KiB. This is part 4 of 4 in the 16K xe series.

--- a/drivers/gpu/drm/xe/xe_migrate.c
+++ b/drivers/gpu/drm/xe/xe_migrate.c
@@ -659,7 +659,7 @@
 			u64 addr, flags = 0;
 			bool devmem = false;
 
-			addr = xe_res_dma(cur) & PAGE_MASK;
+			addr = ALIGN_DOWN(xe_res_dma(cur), XE_PAGE_SIZE);
 			if (is_vram) {
 				if (vm->flags & XE_VM_FLAG_64K) {
 					u64 va = cur_ofs * XE_PAGE_SIZE / 8;
@@ -680,7 +680,7 @@
 			bb->cs[bb->len++] = lower_32_bits(addr);
 			bb->cs[bb->len++] = upper_32_bits(addr);
 
-			xe_res_next(cur, min_t(u32, size, PAGE_SIZE));
+			xe_res_next(cur, min_t(u32, size, XE_PAGE_SIZE));
 			cur_ofs += 8;
 		}
 	}
@@ -1922,7 +1922,7 @@
 					if (idx == chunk)
 						goto next_cmd;
 
-					xe_tile_assert(tile, xe_bo_size(pt_bo) == SZ_4K);
+					xe_tile_assert(tile, xe_bo_size(pt_bo) == PAGE_ALIGN(SZ_4K));
 
 					/* Map a PT at most once */
 					if (pt_bo->update_index < 0)
